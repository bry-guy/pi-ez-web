{
  "name": "pi-ez-web",
  "version": "0.1.0",
  "description": "Self-hostable web UI for Pi coding-agent sessions",
  "scripts": {
    "pretest": "npm run build --prefix vendor/pi-sync",
    "test": "node --test --test-concurrency=2 test/*.test.js",
    "test:dom": "node --test test/dom.test.js",
    "start": "node server/index.js",
    "dev": "PI_WEB_MODE=mock node server/index.js",
    "browser": "playwright open",
    "verify:real": "node scripts/verify-real.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@hono/node-server": "^2.1.0",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.1",
    "marked": "^18.0.9"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1"
  }
}
